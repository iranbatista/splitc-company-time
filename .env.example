# --- Dev local (vite dev) ---------------------------------------------------
# Token da integração interna do Notion (secret_... / ntn_...)
# NUNCA usar prefixo VITE_ — o token só é lido pelo vite.config.ts (processo Node),
# nunca pelo código do browser. Em produção quem guarda o token é o Worker.
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID do data source (não é secreto — vai para o bundle).
NOTION_DATA_SOURCE_ID=COLE_O_DATA_SOURCE_ID_AQUI

# --- Build de produção (setados pelo workflow, não precisa preencher aqui) ---
# API_BASE=https://splitc-notion-proxy.SEU_SUBDOMINIO.workers.dev/v1
# BASE_PATH=/splitc-company-time/
